{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/tvapp/v1/title.schema.json",
  "title": "Canonical title",
  "type": "object",
  "required": ["id", "type", "title", "releaseYear", "genres", "externalIds"],
  "properties": {
    "id": { "type": "string", "pattern": "^title:[a-z0-9-]+:[0-9]{4}$" },
    "type": { "enum": ["series", "movie"] },
    "title": { "type": "string", "minLength": 1 },
    "originalTitle": { "type": "string" },
    "releaseYear": { "type": "integer", "minimum": 1888 },
    "genres": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "runtimeMinutes": { "type": ["integer", "null"], "minimum": 1 },
    "externalIds": { "type": "object", "additionalProperties": { "type": "string" } },
    "series": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "enum": ["planned", "returning", "ended", "cancelled", "unknown"] },
        "seasonCount": { "type": ["integer", "null"], "minimum": 0 }
      },
      "additionalProperties": false
    },
    "aliases": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "series" } } },
      "then": { "required": ["series"] }
    }
  ],
  "additionalProperties": true
}
