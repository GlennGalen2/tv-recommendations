{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/tvapp/v1/viewer.schema.json",
  "title": "Viewer",
  "type": "object",
  "required": ["id", "displayName", "active"],
  "properties": {
    "id": { "type": "string", "pattern": "^viewer-[a-z0-9-]+$" },
    "displayName": { "type": "string", "minLength": 1 },
    "active": { "type": "boolean" }
  },
  "additionalProperties": true
}
