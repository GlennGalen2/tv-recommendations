{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/tvapp/v1/group.schema.json",
  "title": "Viewer group",
  "type": "object",
  "required": ["id", "displayName", "viewerIds", "active"],
  "properties": {
    "id": { "type": "string", "pattern": "^group:[a-z0-9-]+$" },
    "displayName": { "type": "string", "minLength": 1 },
    "viewerIds": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "type": "string" } },
    "active": { "type": "boolean" }
  },
  "additionalProperties": true
}
